@page "/"
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>iF-Hub - Página Inicial</PageTitle>

<div class="mb-6">
    <nav class="flex space-x-4 border-b border-gray-200">
        <button @onclick="@(() => SelectSort("recentes"))" 
                class="py-3 px-1 font-semibold border-b-2 @(currentSortBy == "recentes" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Recentes
        </button>
        <button @onclick="@(() => SelectSort("emalta"))" 
                class="py-3 px-1 font-semibold border-b-2 @(currentSortBy == "emalta" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Em Alta
        </button>
        <button @onclick="@(() => SelectSort("curtidas"))" 
                class="py-3 px-1 font-semibold border-b-2 @(currentSortBy == "curtidas" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Mais Curtidos
        </button>
        <button @onclick="@(() => SelectSort("respostas"))" 
                class="py-3 px-1 font-semibold border-b-2 @(currentSortBy == "respostas" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Mais Respondidos
        </button>
    </nav>
</div>

<div class="space-y-4">
    @if (topics.Count == 0 && isLoading)
    {
        <p><em>Carregando tópicos...</em></p>
    }
    else if (topics.Count == 0)
    {
        <p>Nenhum tópico encontrado para esta seleção.</p>
    }
    else
    {
        @foreach (var topico in topics)
        {
            <article class="topic-card bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-200 flex flex-col">
                <div class="flex-grow">
                    <div class="flex items-center mb-3">
                        <img src="https://placehold.co/40x40/393E46/EEEEEE?text=@(topico.UsuarioNome?.FirstOrDefault())" alt="Avatar do Utilizador" class="w-10 h-10 rounded-full mr-3">
                        <div>
                            <p class="font-semibold username-text">@topico.UsuarioNome</p>
                            <p class="text-sm meta-text">em <a href="@($"/categorias/{topico.CategoriaId}")" class="category-tag hover:underline">@topico.CategoriaNome</a></p>
                        </div>
                    </div>
                    <h2 class="text-xl font-bold mb-2">
                        <a href="@($"/topics/{topico.Id}")" class="topic-title-link">@topico.Titulo</a>
                    </h2>
                </div>
                <div class="flex items-center text-sm meta-text mt-4 pt-4 border-t border-gray-100 space-x-4">
                    <AuthorizeView>
                        <Authorized>
                            <button @onclick="() => ToggleLike(topico)" class="flex items-center transition-transform duration-150 ease-in-out hover:scale-110">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 inline mr-1 transition-colors @(topico.UsuarioCurtiu ? "text-red-500" : "text-gray-400")">
                                    <path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 0 1 8-2.828A4.5 4.5 0 0 1 18 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 0 1-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 0 1-.69.001l-.002-.001Z" />
                                </svg>
                                @topico.TotalCurtidas Curtidas
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <span class="flex items-center">@topico.TotalCurtidas Curtidas</span>
                        </NotAuthorized>
                    </AuthorizeView>

                    <span class="flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-1">
                            <path fill-rule="evenodd" d="M2 5.25A3.25 3.25 0 0 1 5.25 2h9.5A3.25 3.25 0 0 1 18 5.25v7.5A3.25 3.25 0 0 1 14.75 16h-2.072l-1.604 1.203a.75.75 0 0 1-.948 0L8.522 16H5.25A3.25 3.25 0 0 1 2 12.75v-7.5Zm1.5 0V12.75c0 .966.784 1.75 1.75 1.75H8.25l1.004.753a.75.75 0 0 0 .942 0l1.004-.753h2.5a1.75 1.75 0 0 0 1.75-1.75v-7.5a1.75 1.75 0 0 0-1.75-1.75h-9.5a1.75 1.75 0 0 0-1.75 1.75Z" clip-rule="evenodd" />
                        </svg>
                        @topico.TotalRespostas Respostas
                    </span>
                </div>
            </article>
        }
    }
</div>

@if (hasNextPage)
{
    <div class="mt-8 text-center">
        <button @onclick="LoadMoreTopics" class="button-register font-semibold py-3 px-6 rounded-lg shadow-md hover:shadow-lg" disabled="@isLoading">
            @if (isLoading)
            {
                <span>Carregando...</span>
            }
            else
            {
                <span>Carregar Mais</span>
            }
        </button>
    </div>
}


@code {
    private List<TopicListItemViewModel> topics = new();
    private string currentSortBy = "recentes";
    private int currentPage = 1;
    private bool hasNextPage = true;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTopics();
    }

    private async Task LoadTopics()
    {
        if (isLoading) return;
        isLoading = true;
        
        try
        {
            var pagedResult = await Http.GetFromJsonAsync<PagedResultViewModel<TopicListItemViewModel>>($"api/topicos?sortBy={currentSortBy}&page={currentPage}");
            
            if (pagedResult != null && pagedResult.Items.Any())
            {
                topics.AddRange(pagedResult.Items);
                hasNextPage = pagedResult.HasNextPage;
                currentPage = pagedResult.CurrentPage;
            }
            else
            {
                hasNextPage = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao buscar tópicos: {ex.Message}");
            hasNextPage = false;
        }
        
        isLoading = false;
    }

    private async Task SelectSort(string sortBy)
    {
        if (currentSortBy == sortBy) return;

        currentSortBy = sortBy;
        ResetTopicList();
        await LoadTopics();
    }

    private async Task LoadMoreTopics()
    {
        if (hasNextPage)
        {
            currentPage++;
            await LoadTopics();
        }
    }

    private void ResetTopicList()
    {
        topics.Clear();
        currentPage = 1;
        hasNextPage = true;
    }

    private async Task ToggleLike(TopicListItemViewModel topico)
    {
        var response = topico.UsuarioCurtiu
            ? await Http.DeleteAsync($"api/topicos/{topico.Id}/curtir")
            : await Http.PostAsJsonAsync($"api/topicos/{topico.Id}/curtir", new { });

        if (response.IsSuccessStatusCode)
        {
            topico.UsuarioCurtiu = !topico.UsuarioCurtiu;
            topico.TotalCurtidas += topico.UsuarioCurtiu ? 1 : -1;
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}