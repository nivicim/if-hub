@page "/"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>iF-Hub - Página Inicial</PageTitle>

<div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
    <div>
        <h1 class="text-3xl font-bold text-[#222831]">Explorar Tópicos</h1>
        <p class="text-gray-600 mt-1">Veja o que está acontecendo na comunidade de Ciência da Computação do IFSP Salto.</p>
    </div>
    
    <AuthorizeView>
        <Authorized>
            <a href="/topics/new" class="bg-[#00ADB5] hover:bg-[#008c93] text-white font-bold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition duration-150 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Criar Novo Tópico
            </a>
        </Authorized>
        <NotAuthorized>
            <a href="/login" class="bg-[#00ADB5] hover:bg-[#008c93] text-white font-bold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition duration-150 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Faça login para criar um tópico
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="mb-6">
    <nav class="flex space-x-4 border-b border-gray-200 overflow-x-auto pb-1">
        <button @onclick="@(() => SelectSort("recentes"))" 
                class="py-2 px-1 font-semibold border-b-2 whitespace-nowrap transition-colors @(currentSortBy == "recentes" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Recentes
        </button>
        <button @onclick="@(() => SelectSort("emalta"))" 
                class="py-2 px-1 font-semibold border-b-2 whitespace-nowrap transition-colors @(currentSortBy == "emalta" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Em Alta 🔥
        </button>
        <button @onclick="@(() => SelectSort("curtidas"))" 
                class="py-2 px-1 font-semibold border-b-2 whitespace-nowrap transition-colors @(currentSortBy == "curtidas" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Mais Curtidos
        </button>
        <button @onclick="@(() => SelectSort("respostas"))" 
                class="py-2 px-1 font-semibold border-b-2 whitespace-nowrap transition-colors @(currentSortBy == "respostas" ? "text-[#00ADB5] border-[#00ADB5]" : "text-gray-500 border-transparent hover:text-gray-700")">
            Mais Respondidos
        </button>
    </nav>
</div>

<div class="space-y-4">
    @if (topics.Count == 0 && isLoading)
    {
        <div class="flex justify-center py-10">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#00ADB5]"></div>
        </div>
    }
    else if (topics.Count == 0)
    {
        <div class="text-center py-10 bg-gray-50 rounded-xl border border-gray-200">
            <p class="text-gray-500">Nenhum tópico encontrado para esta seleção.</p>
        </div>
    }
    else
    {
        @foreach (var topico in topics)
        {
            <article class="topic-card bg-white p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-200 flex flex-col border border-transparent hover:border-gray-100">
                <div class="flex-grow">
                    <div class="flex items-center mb-3">
                        <img src="https://placehold.co/40x40/393E46/EEEEEE?text=@(topico.UsuarioNome?.FirstOrDefault())" alt="Avatar" class="w-10 h-10 rounded-full mr-3 object-cover shadow-sm">
                        <div>
                            <p class="font-semibold username-text text-gray-900">@topico.UsuarioNome</p>
                            <p class="text-xs meta-text text-gray-500">
                                em <a href="@($"/categorias/{topico.CategoriaId}")" class="category-tag hover:text-[#00ADB5] font-medium transition-colors">@topico.CategoriaNome</a>
                            </p>
                        </div>
                    </div>
                    <h2 class="text-xl font-bold mb-2 text-[#222831] leading-tight">
                        <a href="@($"/topics/{topico.Id}")" class="hover:text-[#00ADB5] transition-colors">@topico.Titulo</a>
                    </h2>
                </div>
                <div class="flex items-center text-sm text-gray-500 mt-4 pt-4 border-t border-gray-100 space-x-6">
                    <AuthorizeView>
                        <Authorized>
                            <button @onclick="() => ToggleLike(topico)" class="flex items-center group transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-1 transition-transform group-hover:scale-110 @(topico.UsuarioCurtiu ? "text-red-500" : "text-gray-400 group-hover:text-red-400")">
                                    <path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 0 1 8-2.828A4.5 4.5 0 0 1 18 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 0 1-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 0 1-.69.001l-.002-.001Z" />
                                </svg>
                                <span class="@(topico.UsuarioCurtiu ? "text-red-600 font-medium" : "")">@topico.TotalCurtidas</span>
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <span class="flex items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-1 text-gray-400">
                                    <path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 0 1 8-2.828A4.5 4.5 0 0 1 18 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 0 1-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 0 1-.69.001l-.002-.001Z" />
                                </svg>
                                @topico.TotalCurtidas
                            </span>
                        </NotAuthorized>
                    </AuthorizeView>

                    <a href="@($"/topics/{topico.Id}")" class="flex items-center hover:text-[#00ADB5] transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-1 text-gray-400">
                            <path fill-rule="evenodd" d="M2 5.25A3.25 3.25 0 0 1 5.25 2h9.5A3.25 3.25 0 0 1 18 5.25v7.5A3.25 3.25 0 0 1 14.75 16h-2.072l-1.604 1.203a.75.75 0 0 1-.948 0L8.522 16H5.25A3.25 3.25 0 0 1 2 12.75v-7.5Zm1.5 0V12.75c0 .966.784 1.75 1.75 1.75H8.25l1.004.753a.75.75 0 0 0 .942 0l1.004-.753h2.5a1.75 1.75 0 0 0 1.75-1.75v-7.5a1.75 1.75 0 0 0-1.75-1.75h-9.5a1.75 1.75 0 0 0-1.75 1.75Z" clip-rule="evenodd" />
                        </svg>
                        @topico.TotalRespostas <span class="hidden sm:inline ml-1">Respostas</span>
                    </a>
                </div>
            </article>
        }
    }
</div>

@if (hasNextPage && !isLoading)
{
    <div class="mt-8 text-center">
        <button @onclick="LoadMoreTopics" class="text-[#00ADB5] hover:text-white border border-[#00ADB5] hover:bg-[#00ADB5] font-semibold py-2 px-6 rounded-full transition duration-300 ease-in-out shadow-sm">
            Carregar Mais Tópicos
        </button>
    </div>
}
else if (isLoading && topics.Count > 0)
{
    <div class="mt-8 text-center">
        <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-[#00ADB5]"></div>
    </div>
}

@code {
    private List<TopicListItemViewModel> topics = new();
    private string currentSortBy = "recentes";
    private int currentPage = 1;
    private bool hasNextPage = true;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTopics();
    }

    private async Task LoadTopics()
    {
        if (isLoading) return;
        isLoading = true;
        
        try
        {
            // Importante: Certifique-se de que sua API no backend já suporta esses parâmetros
            var pagedResult = await Http.GetFromJsonAsync<PagedResultViewModel<TopicListItemViewModel>>($"api/topicos?sortBy={currentSortBy}&page={currentPage}");
            
            if (pagedResult != null && pagedResult.Items.Any())
            {
                topics.AddRange(pagedResult.Items);
                hasNextPage = pagedResult.HasNextPage;
                currentPage = pagedResult.CurrentPage;
            }
            else
            {
                hasNextPage = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao buscar tópicos: {ex.Message}");
            hasNextPage = false;
        }
        
        isLoading = false;
    }

    private async Task SelectSort(string sortBy)
    {
        if (currentSortBy == sortBy) return;

        currentSortBy = sortBy;
        ResetTopicList();
        await LoadTopics();
    }

    private async Task LoadMoreTopics()
    {
        if (hasNextPage)
        {
            currentPage++;
            await LoadTopics();
        }
    }

    private void ResetTopicList()
    {
        topics.Clear();
        currentPage = 1;
        hasNextPage = true;
    }

    private async Task ToggleLike(TopicListItemViewModel topico)
    {
        var response = topico.UsuarioCurtiu
            ? await Http.DeleteAsync($"api/topicos/{topico.Id}/curtir")
            : await Http.PostAsJsonAsync($"api/topicos/{topico.Id}/curtir", new { });

        if (response.IsSuccessStatusCode)
        {
            topico.UsuarioCurtiu = !topico.UsuarioCurtiu;
            topico.TotalCurtidas += topico.UsuarioCurtiu ? 1 : -1;
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}