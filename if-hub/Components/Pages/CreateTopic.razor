@page "/topics/new"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Criar Novo Tópico</PageTitle>

<AuthorizeView Context="authContext">
    <Authorized>
        <div class="w-full max-w-4xl mx-auto">
            <h1 class="text-3xl font-bold text-[#222831] mb-6">Crie um Novo Tópico</h1>
            <article class="topic-card bg-white p-6 sm:p-8 rounded-xl shadow-lg">
                @if (categories == null)
                {
                    <p><em>Carregando categorias...</em></p>
                }
                else
                {
                    <EditForm Model="newTopic" OnValidSubmit="HandleCreateTopic">
                        <DataAnnotationsValidator />
                        <div class="space-y-6">
                            @* Título, Categoria, Conteúdo *@
                            <div>
                                <label for="titulo" class="block mb-2 text-sm font-medium text-gray-900">Título</label>
                                <InputText id="titulo" @bind-Value="newTopic.Titulo" class="w-full px-4 py-2 border search-input rounded-lg" />
                                <ValidationMessage For="@(() => newTopic.Titulo)" class="text-red-600 text-sm mt-1" />
                            </div>
                            <div>
                                <label for="categoria" class="block mb-2 text-sm font-medium text-gray-900">Categoria</label>
                                <InputSelect id="categoria" @bind-Value="newTopic.CategoriaId" class="w-full px-4 py-2 border search-input rounded-lg">
                                    <option value="0" disabled selected>-- Selecione uma categoria --</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">@category.Nome</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => newTopic.CategoriaId)" class="text-red-600 text-sm mt-1" />
                            </div>
                            <div>
                                <label for="conteudo" class="block mb-2 text-sm font-medium text-gray-900">Conteúdo</label>
                                <InputTextArea id="conteudo" @bind-Value="newTopic.Conteudo" class="w-full px-4 py-2 border search-input rounded-lg" rows="10" />
                                <ValidationMessage For="@(() => newTopic.Conteudo)" class="text-red-600 text-sm mt-1" />
                            </div>

                            <div>
                                <label for="imagens" class="block mb-2 text-sm font-medium text-gray-900">Imagens para o Carrossel (Opcional)</label>
                                <InputFile id="imagens" OnChange="OnImagesSelected" multiple accept="image/*" class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50" />
                                @if (uploadingImages)
                                {
                                    <p class="text-sm text-blue-600 mt-2"><em>Enviando imagens...</em></p>
                                }
                            </div>
                            <div>
                                <label for="outros-anexos" class="block mb-2 text-sm font-medium text-gray-900">Outros Anexos (PDF, ZIP, etc. - Opcional)</label>
                                <InputFile id="outros-anexos" OnChange="OnOtherFilesSelected" multiple class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50" />
                                @if (uploadingFiles)
                                {
                                    <p class="text-sm text-blue-600 mt-2"><em>Enviando outros anexos...</em></p>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg" role="alert">
                                    @errorMessage
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(warningMessage))
                            {
                                <div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded-lg" role="alert">
                                    @warningMessage
                                </div>
                            }

                            <div class="flex justify-end gap-4">
                                <a href="/" class="button-login font-semibold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition">Cancelar</a>
                                <button type="submit" disabled="@(uploadingImages || uploadingFiles)" class="create-topic-button font-semibold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed">
                                    @((uploadingImages || uploadingFiles) ? "Aguarde o upload..." : "Publicar Tópico")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </article>
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Você precisa <a href="/login" class="topic-title-link">fazer login</a> para criar um novo tópico.</p>
    </NotAuthorized>
</AuthorizeView>


@code {
    private CreateTopicViewModel newTopic = new()
    {
        Imagens = new List<AnexoViewModel>(),
        OutrosAnexos = new List<AnexoViewModel>()
    };

    private List<CategoriaViewModel>? categories;
    private string? errorMessage;
    private string? warningMessage;
    private bool uploadingImages = false;
    private bool uploadingFiles = false;

    private const long MaxFileSize = 10 * 1024 * 1024; // 10 MB

    protected override async Task OnInitializedAsync()
    {
        try { categories = await Http.GetFromJsonAsync<List<CategoriaViewModel>>("api/categorias"); }
        catch (Exception ex) { errorMessage = $"Erro ao carregar categorias: {ex.Message}"; }
    }

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        warningMessage = null;
        uploadingImages = true;
        newTopic.Imagens.Clear();

        var files = e.GetMultipleFiles();
        if (files.Count > 6)
        {
            warningMessage = "Limite de 6 imagens excedido. Apenas as 6 primeiras serão enviadas.";
        }

        foreach (var file in files.Take(6))
        {
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"O arquivo de imagem '{file.Name}' excede o limite de 10 MB.";
                uploadingImages = false;
                return;
            }
            var result = await UploadFile(file);
            if (result != null)
            {
                newTopic.Imagens.Add(new AnexoViewModel { Url = result.Url, NomeArquivo = result.FileName, TipoConteudo = result.ContentType });
            }
        }
        uploadingImages = false;
    }



    private async Task OnOtherFilesSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        warningMessage = null;
        uploadingFiles = true;
        newTopic.OutrosAnexos.Clear();

        var files = e.GetMultipleFiles();
        if (files.Count > 2)
        {
            warningMessage = "Limite de 2 anexos excedido. Apenas os 2 primeiros serão enviados.";
        }

        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"O arquivo '{file.Name}' excede o limite de 10 MB.";
                uploadingFiles = false;
                return;
            }
            var result = await UploadFile(file);
            if (result != null)
            {
                newTopic.OutrosAnexos.Add(new AnexoViewModel { Url = result.Url, NomeArquivo = result.FileName, TipoConteudo = result.ContentType });
            }
        }
        uploadingFiles = false;
    }



    private async Task<UploadResult?> UploadFile(IBrowserFile file)
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            using var content = new MultipartFormDataContent();
            using var fileStream = file.OpenReadStream(MaxFileSize);
            using var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var request = new HttpRequestMessage(HttpMethod.Post, "api/upload");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = content;

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                return await response.Content.ReadFromJsonAsync<UploadResult>();
            }
            errorMessage = $"Erro ao enviar o arquivo '{file.Name}'.";
            return null;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro inesperado ao enviar o arquivo '{file.Name}': {ex.Message}";
            return null;
        }
    }

    private async Task HandleCreateTopic()
    {
        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        var response = await Http.PostAsJsonAsync("api/topicos", newTopic);
        Http.DefaultRequestHeaders.Authorization = null;

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<TopicIdResponse>();
            if (result != null) Navigation.NavigateTo($"/topics/{result.Id}");
        }
        else
        {
            errorMessage = "Erro ao publicar o tópico. Verifique os campos.";
        }
    }

    public class UploadResult { public string? Url { get; set; } public string? FileName { get; set; } public string? ContentType { get; set; } }
    public class TopicIdResponse { public int Id { get; set; } }
}