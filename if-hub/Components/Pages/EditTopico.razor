@page "/topics/edit/{TopicId:int}"
@using System.Net.Http.Headers
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims


@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Editar Tópico</PageTitle>

<div class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-lg">
    <h1 class="text-3xl font-bold text-[#222831] mb-6">Editar Tópico</h1>

    @if (isLoading)
    {
        <p>Carregando...</p>
    }
    else if (updateModel == null)
    {
        <p class="text-red-500">Não foi possível carregar o tópico.</p>
    }
    else
    {
        <EditForm Model="updateModel" OnValidSubmit="HandleUpdateTopic">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-6">
                <label for="titulo" class="block mb-2 text-sm font-medium text-gray-900">Título</label>
                <InputText id="titulo" @bind-Value="updateModel.Titulo" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#00ADB5] focus:border-[#00ADB5] block w-full p-2.5" />
                <ValidationMessage For="@(() => updateModel.Titulo)" />
            </div>

            <div class="mb-6">
                <label for="conteudo" class="block mb-2 text-sm font-medium text-gray-900">Conteúdo</label>
                <InputTextArea id="conteudo" @bind-Value="updateModel.Conteudo" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#00ADB5] focus:border-[#00ADB5] block w-full p-2.5" rows="8" />
                <ValidationMessage For="@(() => updateModel.Conteudo)" />
            </div>

            @if (currentAttachments.Any())
            {
                <div class="mb-6">
                    <label class="block mb-2 text-sm font-medium text-gray-900">Anexos Atuais:</label>
                    <ul class="space-y-2">
                        @foreach (var anexo in currentAttachments)
                        {
                            <li class="flex justify-between items-center bg-gray-50 p-2 rounded border">
                                <span class="text-sm truncate max-w-xs">@anexo.NomeArquivo</span>
                                <button type="button" @onclick="() => DeleteAttachment(anexo.Id)" class="text-red-600 hover:text-red-800 text-sm font-semibold">
                                    Remover
                                </button>
                            </li>
                        }
                    </ul>
                    <p class="text-xs text-gray-500 mt-1">Atenção: Remover um anexo aqui o exclui permanentemente.</p>
                </div>
            }

            <div class="mb-6">
                <label class="block mb-2 text-sm font-medium text-gray-900">Adicionar Imagens (Carrossel)</label>
                <InputFile OnChange="@(e => LoadFiles(e, true))" multiple accept="image/*" class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50" />
            </div>

            <div class="mb-6">
                <label class="block mb-2 text-sm font-medium text-gray-900">Adicionar Outros Anexos</label>
                <InputFile OnChange="@(e => LoadFiles(e, false))" multiple class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
                    @errorMessage
                </div>
            }

            <div class="flex justify-end gap-4">
                <a href="/topics/@TopicId" class="text-gray-600 hover:text-gray-800 font-semibold py-2.5 px-5">Cancelar</a>
                <button type="submit" class="text-white bg-[#00ADB5] hover:bg-[#008c93] focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center shadow-md transition-all disabled:opacity-50" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Salvando...</span>
                    }
                    else
                    {
                        <span>Salvar Alterações</span>
                    }
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int TopicId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    private UpdateTopicViewModel? updateModel;
    private List<AnexoViewModel> currentAttachments = new();
    private List<IBrowserFile> newImages = new();
    private List<IBrowserFile> newOtherFiles = new();
    
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private const long MaxFileSize = 10 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Busca os dados atuais do tópico
            var topicDetail = await Http.GetFromJsonAsync<TopicDetailViewModel>($"api/topicos/{TopicId}");

            if (topicDetail == null)
            {
                Navigation.NavigateTo("/");
                return;
            }

            // 2. Verifica se o usuário é o dono ou Admin
            var authState = await AuthenticationStateTask;
            var user = authState.User;
            var userId = user.FindFirstValue("UserId");
            var userRole = user.FindFirstValue(ClaimTypes.Role);

            if (userId != topicDetail.UsuarioId.ToString() && userRole != "3" && userRole != "2")
            {
                Navigation.NavigateTo($"/topics/{TopicId}"); // Não tem permissão
                return;
            }

            // 3. Prepara o modelo de edição
            updateModel = new UpdateTopicViewModel
            {
                Titulo = topicDetail.Titulo,
                Conteudo = topicDetail.Conteudo
            };
            currentAttachments = topicDetail.Anexos;
        }
        catch (Exception ex)
        {
            errorMessage = "Erro ao carregar tópico: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void LoadFiles(InputFileChangeEventArgs e, bool isImage)
    {
        var files = e.GetMultipleFiles(isImage ? 6 : 2);
        if (isImage) newImages = files.ToList();
        else newOtherFiles = files.ToList();
    }

    private async Task DeleteAttachment(int anexoId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza? O arquivo será apagado permanentemente.")) return;

        var response = await Http.DeleteAsync($"api/anexos/{anexoId}");
        if (response.IsSuccessStatusCode)
        {
            currentAttachments.RemoveAll(a => a.Id == anexoId);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Erro ao remover anexo.");
        }
    }

    private async Task HandleUpdateTopic()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(updateModel.Titulo), "Titulo");
            content.Add(new StringContent(updateModel.Conteudo), "Conteudo");

            foreach (var file in newImages)
            {
                var fileContent = new StreamContent(file.OpenReadStream(MaxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "Imagens", file.Name);
            }

            foreach (var file in newOtherFiles)
            {
                var fileContent = new StreamContent(file.OpenReadStream(MaxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "OutrosAnexos", file.Name);
            }

            var response = await Http.PutAsync($"api/topicos/{TopicId}", content);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/topics/{TopicId}");
            }
            else
            {
                errorMessage = "Erro ao atualizar tópico.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erro inesperado: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}