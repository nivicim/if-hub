@page "/admin/reports"
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Painel de Denúncias</PageTitle>

<AuthorizeView Roles="2,3">
    <Authorized>
        <h1 class="text-3xl font-bold text-[#222831] mb-6">Painel de Denúncias Pendentes</h1>

        @if (denuncias == null)
        {
            <p><em>Carregando denúncias...</em></p>
        }
        else if (!denuncias.Any())
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg">
                <p>🎉 Nenhuma denúncia pendente no momento!</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var denuncia in denuncias)
                {
                    <div class="bg-white p-6 rounded-xl shadow-lg">
                        <div class="flex justify-between items-start">
                            <div>
                                <div class="flex items-center gap-x-3">
                                    <p class="text-sm text-gray-500">
                                        Denúncia #@denuncia.Id
                                    </p>
                                    
                                    @if (denuncia.RespostaId.HasValue)
                                    {
                                        <span class="inline-block bg-indigo-100 text-indigo-800 text-xs font-semibold px-2 py-1 rounded-full">RESPOSTA</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded-full">TÓPICO</span>
                                    }
                                </div>
                                <p class="text-sm text-gray-500 mt-1">
                                    Feita por <span class="font-semibold text-gray-800">@denuncia.AutorNome</span> em @denuncia.DataCriacao.ToString("dd/MM/yyyy 'às' HH:mm")
                                </p>
                            </div>
                            <div class="flex gap-2">
                                <button @onclick="() => AprovarDenuncia(denuncia.Id)" class="px-3 py-1 text-xs font-semibold text-white bg-green-500 rounded-md hover:bg-green-600 transition">Aprovar</button>
                                <button @onclick="() => RejeitarDenuncia(denuncia.Id)" class="px-3 py-1 text-xs font-semibold text-white bg-red-500 rounded-md hover:bg-red-600 transition">Rejeitar</button>
                            </div>
                        </div>

                        <div class="mt-4 border-t pt-4">
                            <h4 class="font-semibold text-gray-800">Motivo da Denúncia:</h4>
                            <p class="text-gray-700">"@denuncia.Motivo"</p>
                        </div>

                        <div class="mt-4 bg-gray-50 p-3 rounded-lg border">
                            <h5 class="text-xs font-semibold text-gray-600 mb-1">
                                @(denuncia.RespostaId.HasValue ? "Prévia da Resposta Denunciada:" : "Prévia do Tópico Denunciado:")
                            </h5>
                            <p class="text-sm text-gray-800 italic">
                                "@denuncia.ConteudoDenunciadoPreview..."
                            </p>
                            <a href="@($"/topics/{denuncia.TopicoId}")" target="_blank" class="text-blue-600 hover:underline text-xs mt-2 inline-block">
                                @(denuncia.RespostaId.HasValue ? "Ver resposta no tópico ↗" : "Ver tópico completo ↗")
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <h3 class="text-xl text-red-600">Acesso Negado</h3>
        <p>Você não tem permissão para acessar esta página.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<DenunciaViewModel>? denuncias;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDenuncias();
    }

    private async Task LoadDenuncias()
    {
        try
        {
            denuncias = await Http.GetFromJsonAsync<List<DenunciaViewModel>>("api/admin/denuncias");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao buscar denúncias: {ex.Message}";
        }
    }

    private async Task RejeitarDenuncia(int denunciaId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Tem certeza que deseja REJEITAR esta denúncia? Esta ação não pode ser desfeita.");
        if (!confirmed) return;

        var response = await Http.PostAsync($"api/admin/denuncias/{denunciaId}/rejeitar", null);
        if (response.IsSuccessStatusCode)
        {
            denuncias?.RemoveAll(d => d.Id == denunciaId);
        }
        else
        {
            errorMessage = "Erro ao rejeitar a denúncia.";
        }
    }

    private async Task AprovarDenuncia(int denunciaId)
    {
        var justificativa = await JSRuntime.InvokeAsync<string>("prompt", "Por favor, insira uma justificativa para a remoção do conteúdo (visível no log de moderação):");
        if (string.IsNullOrWhiteSpace(justificativa))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Ação cancelada. A justificativa é obrigatória.");
            return;
        }

        var model = new AprovarDenunciaViewModel { Justificativa = justificativa };
        var response = await Http.PostAsJsonAsync($"api/admin/denuncias/{denunciaId}/aprovar", model);

        if (response.IsSuccessStatusCode)
        {
            denuncias?.RemoveAll(d => d.Id == denunciaId);
        }
        else
        {
            errorMessage = "Erro ao aprovar a denúncia e remover o conteúdo.";
        }
    }
}