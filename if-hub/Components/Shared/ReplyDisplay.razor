@using System.Net.Http.Headers
@using System.Net.Http.Json
@using if_hub.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<article class="topic-card bg-white p-6 rounded-xl shadow-lg">
    @* O @if principal começa aqui, dentro do <article> *@
    @if (Resposta.Excluida)
    {
        @* MODO EXCLUÍDO: Mostra apenas a mensagem simples dentro do card *@
        <div class="p-4 bg-gray-50 rounded-lg">
            <p class="text-sm italic text-gray-500">@Resposta.Conteudo</p>
        </div>
    }
    else
    {
        @* MODO NORMAL: Mostra todo o conteúdo e botões *@
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center">
                <img src="https://placehold.co/40x40/393E46/EEEEEE?text=@(Resposta.UsuarioNome?.FirstOrDefault())" alt="Avatar do Utilizador" class="w-10 h-10 rounded-full mr-3">
                <div>
                    <p class="font-semibold username-text">@Resposta.UsuarioNome</p>
                    <p class="text-sm meta-text"><time datetime="@Resposta.DataCriacao.ToString("yyyy-MM-dd")">@Resposta.DataCriacao.ToString("dd 'de' MMMM, yyyy 'às' HH:mm")</time></p>
                </div>
            </div>
        </div>

        @if (ParentPage.IsEditing(Resposta.Id))
        {
            @* MODO DE EDIÇÃO *@
            <EditForm Model="UpdateModel" OnValidSubmit="ParentPage.HandleUpdateReply">
                <DataAnnotationsValidator />
                <InputTextArea @bind-Value="UpdateModel.Conteudo" class="w-full px-4 py-2 border search-input rounded-lg" rows="4"></InputTextArea>
                <ValidationMessage For="@(() => UpdateModel.Conteudo)" />
                <div class="flex justify-end gap-2 mt-2">
                    <button type="button" @onclick="ParentPage.CancelEditing" class="text-sm text-gray-600 hover:text-gray-800 font-semibold">Cancelar</button>
                    <button type="submit" class="text-sm text-green-600 hover:text-green-800 font-semibold">Salvar</button>
                </div>
            </EditForm>
        }
        else
        {
            @* MODO DE VISUALIZAÇÃO *@
            <div class="paragraph-text leading-relaxed break-words">
                @((MarkupString)Resposta.Conteudo.Replace("\n", "<br/>"))
                @if (Resposta.EditadoEm.HasValue)
                {
                    <em class="text-xs meta-text block mt-2">(Editado)</em>
                }
            </div>
        }

        @if (Resposta.Anexos != null && Resposta.Anexos.Any())
        {

            var imagensDaResposta = Resposta.Anexos.Where(a => a.TipoConteudo.StartsWith("image/")).ToList();
            var outrosAnexos = Resposta.Anexos.Where(a => !a.TipoConteudo.StartsWith("image/")).ToList();


            @if (imagensDaResposta.Any())
            {
                <div class="mt-3 flex flex-wrap gap-2">
                    @foreach (var anexo in imagensDaResposta)
                    {
                        <a href="@anexo.Url" data-fancybox="reply-gallery-@Resposta.Id" data-caption="@anexo.NomeArquivo" data-no-nav>
                            <img src="@anexo.Url" alt="@anexo.NomeArquivo" class="max-w-[120px] max-h-24 rounded shadow-sm hover:shadow-md transition-shadow" />
                        </a>
                    }
                </div>
            }
            @if (outrosAnexos.Any())
            {
                <div class="mt-3 p-3 bg-gray-50 border rounded-lg">
                    <h5 class="font-semibold text-xs mb-1">Anexos:</h5>
                    <ul class="list-disc list-inside space-y-1">
                        @foreach (var anexo in outrosAnexos)
                        {
                            <li><a href="@anexo.Url" target="_blank" class="topic-title-link text-xs">@anexo.NomeArquivo</a></li>
                        }
                    </ul>
                </div>
            }
        }

        <div class="flex items-center justify-end gap-4 mt-2 pt-2 border-t">
            <AuthorizeView>
                <Authorized>
                    <button @onclick="() => ParentPage.ToggleReplyLike(Resposta)" class="flex items-center text-sm meta-text transition-transform duration-150 ease-in-out hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 inline mr-1 transition-colors @(Resposta.UsuarioCurtiu ? "text-red-500" : "text-gray-400")">
                            <path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 0 1-1.162-.682 22.045 22.045 0 0 1-2.582-1.9C4.045 12.733 2 10.352 2 7.5a4.5 4.5 0 0 1 8-2.828A4.5 4.5 0 0 1 18 7.5c0 2.852-2.044 5.233-3.885 6.82a22.049 22.049 0 0 1-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 0 1-.69.001l-.002-.001Z" />
                        </svg>
                        @Resposta.TotalCurtidas
                    </button>
                </Authorized>
                <NotAuthorized>
                    <span class="flex items-center text-sm meta-text">@Resposta.TotalCurtidas Curtidas</span>
                </NotAuthorized>
            </AuthorizeView>

            @if (!ParentPage.IsEditing(Resposta.Id))
            {
                <div class="flex gap-2">
                    @if (ParentPage.IsOwnerOfReply(Resposta))
                    {
                        <button @onclick="() => ParentPage.StartEditingReply(Resposta)" class="text-sm text-blue-600 hover:text-blue-800 font-semibold">Editar</button>
                        <button @onclick="() => ParentPage.HandleDeleteReply(Resposta.Id)" class="text-sm text-red-600 hover:text-red-800 font-semibold">Excluir</button>
                    }
                    <button @onclick="() => ParentPage.StartReplyToReply(Resposta)" class="text-sm text-gray-600 hover:text-gray-900 font-semibold">Responder</button>
                </div>
            }
        </div>
    }
</article>

@if (Resposta.RespostasFilhas != null && Resposta.RespostasFilhas.Any())
{
    @* A renderização das respostas filhas fica aqui, FORA do <article> principal,
       para que elas continuem aparecendo mesmo que o pai seja excluído. *@
    <div class="ml-8 mt-4 space-y-4 border-l-2 border-gray-200 pl-4">
        @foreach (var filha in Resposta.RespostasFilhas.OrderBy(r => r.DataCriacao))
        {
            <ReplyDisplay Resposta="filha" ParentPage="ParentPage" UpdateModel="UpdateModel" />
        }
    </div>
}


@code {
    [Parameter, EditorRequired]
    public RespostaViewModel Resposta { get; set; } = null!;

    [Parameter, EditorRequired]
    public if_hub.Components.Pages.TopicoDetail ParentPage { get; set; } = null!;

    [Parameter, EditorRequired]
    public UpdateRespostaViewModel UpdateModel { get; set; } = null!;
}